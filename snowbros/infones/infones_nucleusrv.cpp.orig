// InfoNES Platform Implementation for NucleusRV on Digilent Zybo Z7
// Optimized for Snow Brothers (NES Mapper 1 - MMC1)

#include "InfoNES.h"
#include "InfoNES_System.h"
#include "InfoNES_Types.h"
#include <stdint.h>
#include <stddef.h>
#include <string.h>

// ---------------------------------------------------------------------------
// 1. Hardware Memory Map
// ---------------------------------------------------------------------------
#define UART_DATA_REG     (*(volatile uint32_t*)0x40000000)
#define UART_STATUS_REG   (*(volatile uint32_t*)0x40000004)
#define BTN_STATUS_REG    (*(volatile uint32_t*)0x40000008) // BTN1=bit0, BTN2=bit1, BTN3=bit2
#define SW_STATUS_REG     (*(volatile uint32_t*)0x4000000C)
#define TIMER_MS_REG      (*(volatile uint32_t*)0x40000010)

#define FB_MEM_BASE       ((volatile uint8_t*)0x50000000)
#define PALETTE_MEM_BASE  ((volatile uint32_t*)0x50010000)

// DDR3 Memory Map (Zynq AXI HP0)
#define NES_ROM_DDR3_ADDR ((const uint8_t*)0x10800000)

// ---------------------------------------------------------------------------
// 2. UART Console Output
// ---------------------------------------------------------------------------
#define DLOG_HDR          ((volatile uint32_t*)0x23F00000)  // [0]=magic [1]=bytes written
#define DLOG_DATA         ((volatile uint8_t*)0x23F00100)
#define DLOG_SIZE         0xFF00u
#define DLOG_MAGIC        0x474F4C44u                        // "DLOG"

static void dlog_putc(char c) {
    static uint32_t count = 0;
    if (count == 0) DLOG_HDR[0] = DLOG_MAGIC;
    DLOG_DATA[count % DLOG_SIZE] = (uint8_t)c;
    DLOG_HDR[1] = ++count;
}

extern "C" void uart_putchar(char c) {
    dlog_putc(c);
    while (!(UART_STATUS_REG & 0x02)); // Wait for TX ready
    UART_DATA_REG = (uint32_t)(uint8_t)c;
}

extern "C" void uart_puts(const char* s) {
    while (*s) {
        if (*s == '\n') uart_putchar('\r');
        uart_putchar(*s++);
    }
}

// ---------------------------------------------------------------------------
// 3. NES Master Palette (64 Colors, 24-bit RGB)
// ---------------------------------------------------------------------------
static const uint32_t s_nes_palette[64] = {
    0x7C7C7C, 0x0000FC, 0x0000BC, 0x4428BC, 0x940084, 0xA80020, 0xA81000, 0x881400,
    0x503000, 0x007800, 0x006800, 0x005800, 0x004058, 0x000000, 0x000000, 0x000000,
    0xBCBCBC, 0x0078F8, 0x0058F8, 0x6844FC, 0xD800CC, 0xE40058, 0xF83800, 0xE45C10,
    0xAC7C00, 0x00B800, 0x00A800, 0x00A844, 0x008888, 0x000000, 0x000000, 0x000000,
    0xF8F8F8, 0x3CBCFC, 0x6888FC, 0x9878F8, 0xF878F8, 0xF85898, 0xF87858, 0xFCA044,
    0xF8B800, 0xB8F818, 0x58D854, 0x58F898, 0x00E8D8, 0x787878, 0x000000, 0x000000,
    0xFFFFFF, 0xA4E4FC, 0xB8B8F8, 0xD8B8F8, 0xF8B8F8, 0xF8A4C0, 0xF0D0B0, 0xFCE0A8,
    0xF8D878, 0xD8F878, 0xB8F8B8, 0xB8F8D8, 0x00FCFC, 0xF8D8F8, 0x000000, 0x000000
};

WORD NesPalette[ 64 ];

// ---------------------------------------------------------------------------
// 4. InfoNES Display Driver: Centered 256x200 inside 320x200 Framebuffer
// ---------------------------------------------------------------------------
void InfoNES_LoadFrame()
{
    // 320x200 BRAM Framebuffer at 0x50000000.
    // Center 256 pixels horizontally inside 320 (32 pixels left & right margin).
    // Display scanlines 20..219 (200 lines total, skipping 20 top/bottom overscan).
    for (int y = 0; y < 200; ++y)
    {
        volatile uint32_t *dst = (volatile uint32_t *)(FB_MEM_BASE + (y * 320) + 32);
        const WORD *src = &WorkFrame[(y + 20) * NES_DISP_WIDTH];

        // 32-bit burst write: 4 pixels per single bus store word
        for (int x = 0; x < 256; x += 4)
        {
            uint32_t p0 = (uint32_t)(src[x + 0] & 0x3F);
            uint32_t p1 = (uint32_t)(src[x + 1] & 0x3F);
            uint32_t p2 = (uint32_t)(src[x + 2] & 0x3F);
            uint32_t p3 = (uint32_t)(src[x + 3] & 0x3F);
            *dst++ = p0 | (p1 << 8) | (p2 << 16) | (p3 << 24);
        }
    }
}

// ---------------------------------------------------------------------------
// 5. Joypad & Interactive Controls
// ---------------------------------------------------------------------------
// Bit 0: A (Jump)
// Bit 1: B (Shoot / Throw)
// Bit 2: Select
// Bit 3: Start
// Bit 4: Up
// Bit 5: Down
// Bit 6: Left
// Bit 7: Right

static uint32_t s_uart_pad = 0;
static uint32_t s_uart_decay_time = 0;

void InfoNES_PadState( DWORD *pdwPad1, DWORD *pdwPad2, DWORD *pdwSystem )
{
    uint32_t pad = 0;

    // 5.1 Onboard Zybo Push Buttons
    uint32_t btns = BTN_STATUS_REG & 0x07;
    if (btns & 0x01) pad |= (1 << 0); // BTN1 = Jump / A
    if (btns & 0x02) pad |= (1 << 1); // BTN2 = Shoot / B
    if (btns & 0x04) pad |= (1 << 4); // BTN3 = Up

    // 5.2 Onboard Zybo Slide Switches
    uint32_t sws = SW_STATUS_REG & 0x0F;
    if (sws & 0x01) pad |= (1 << 3); // SW0 = Start
    if (sws & 0x02) pad |= (1 << 2); // SW1 = Select

    // 5.3 UART Serial Keyboard with auto-release decay
    uint32_t now = TIMER_MS_REG;
    if (UART_STATUS_REG & 0x01)
    {
        uint8_t ch = (uint8_t)(UART_DATA_REG & 0xFF);
        s_uart_decay_time = now + 120; // Hold button for 120ms

        switch (ch)
        {
            case 'w': case 'W': s_uart_pad = (1 << 4); break; // Up
            case 's': case 'S': s_uart_pad = (1 << 5); break; // Down
            case 'a': case 'A': s_uart_pad = (1 << 6); break; // Left
            case 'd': case 'D': s_uart_pad = (1 << 7); break; // Right

            case ' ': case 'k': case 'K':
                s_uart_pad = (1 << 0); break; // A (Jump)

            case 'j': case 'J':
                s_uart_pad = (1 << 1); break; // B (Shoot)

            case '\r': case '\n':
                s_uart_pad = (1 << 3); break; // Start

            case 27:
                s_uart_pad = (1 << 2); break; // Select

            default: break;
        }
    }

    if (now > s_uart_decay_time)
    {
        s_uart_pad = 0;
    }

    pad |= s_uart_pad;

    *pdwPad1 = pad;
    *pdwPad2 = 0;
    *pdwSystem = 0;
}

// ---------------------------------------------------------------------------
// 6. ROM Reader: Direct Zero-Copy from External DDR3 SDRAM
// ---------------------------------------------------------------------------
int InfoNES_ReadRom( const char *pszFileName )
{
    (void)pszFileName;
    const uint8_t *pCursor = NES_ROM_DDR3_ADDR;

    // Verify "NES\x1a" magic signature
    if (memcmp(pCursor, "NES\x1a", 4) != 0)
    {
        uart_puts("\n[InfoNES] ERROR: Valid .NES ROM header not found at DDR3 0x10800000!\n");
        uart_puts("[InfoNES] Please ensure snow_bros.nes is loaded to 0x10800000 via XSDB.\n");
        return -1;
    }

    memcpy(&NesHeader, pCursor, sizeof(NesHeader));
    pCursor += sizeof(NesHeader);

    // Clear SRAM
    memset(SRAM, 0, SRAM_SIZE);

    // Read Trainer (if present)
    if (NesHeader.byInfo1 & 4)
    {
        memcpy(&SRAM[0x1000], pCursor, 512);
        pCursor += 512;
    }

    // Set PRG-ROM base pointer in DDR3
    ROM = (BYTE*)pCursor;
    pCursor += (DWORD)NesHeader.byRomSize * 0x4000;

    // Set CHR-ROM base pointer in DDR3 (if present)
    if (NesHeader.byVRomSize > 0)
    {
        VROM = (BYTE*)pCursor;
        pCursor += (DWORD)NesHeader.byVRomSize * 0x2000;
    }
    else
    {
        VROM = NULL;
    }

    uart_puts("[InfoNES] [PASS] ROM successfully mounted from DDR3 @ 0x10800000.\n");
    return 0;
}

void InfoNES_ReleaseRom()
{
    ROM = NULL;
    VROM = NULL;
}

// ---------------------------------------------------------------------------
// 7. System Callbacks & Stubs
// ---------------------------------------------------------------------------
int InfoNES_Menu()
{
    return 0; // Directly start emulation without menu
}

void *InfoNES_MemoryCopy( void *dest, const void *src, int count )
{
    return memcpy( dest, src, count );
}

void *InfoNES_MemorySet( void *dest, int c, int count )
{
    return memset( dest, c, count );
}

void InfoNES_DebugPrint( char *pszMsg )
{
    uart_puts( pszMsg );
}

void InfoNES_MessageBox( char *pszMsg, ... )
{
    uart_puts( pszMsg );
}

void InfoNES_Wait()
{
    // Free-running execution for maximum framerate
}

// Audio synthesis disabled to preserve 100% of RV32IM compute budget
void InfoNES_SoundInit( void ) {}
int InfoNES_SoundOpen( int samples_per_sync, int sample_rate ) { (void)samples_per_sync; (void)sample_rate; return 0; }
void InfoNES_SoundClose( void ) {}
void InfoNES_SoundOutput(int samples, BYTE *wave1, BYTE *wave2, BYTE *wave3, BYTE *wave4, BYTE *wave5)
{
    (void)samples; (void)wave1; (void)wave2; (void)wave3; (void)wave4; (void)wave5;
}

// ---------------------------------------------------------------------------
// 8. Newlib Libc System Calls (Bare-Metal Stubs)
// ---------------------------------------------------------------------------
#define HEAP_DDR3_START   0x12000000u
#define HEAP_DDR3_END     0x13F00000u

extern "C" void *_sbrk(ptrdiff_t incr)
{
    static uint32_t heap_end = HEAP_DDR3_START;
    uint32_t prev = heap_end;
    if (incr < 0 || heap_end + (uint32_t)incr > HEAP_DDR3_END)
    {
        uart_puts("[SYS] _sbrk: out of heap\n");
        return (void *)-1;
    }
    heap_end += (uint32_t)incr;
    return (void *)prev;
}

extern "C" int _write(int fd, const char *buf, int len)
{
    (void)fd;
    for (int i = 0; i < len; ++i)
    {
        if (buf[i] == '\n') uart_putchar('\r');
        uart_putchar(buf[i]);
    }
    return len;
}

extern "C" void _exit(int status)
{
    (void)status;
    uart_puts("\n[SYS] Emulation halted.\n");
    while (1);
}

extern "C" int _close(int fd) { (void)fd; return -1; }
extern "C" int _fstat(int fd, void *st) { (void)fd; (void)st; return -1; }
extern "C" int _isatty(int fd) { (void)fd; return 1; }
extern "C" int _lseek(int fd, int off, int whence) { (void)fd; (void)off; (void)whence; return 0; }
extern "C" int _read(int fd, char *buf, int len) { (void)fd; (void)buf; (void)len; return 0; }
extern "C" int _kill(int pid, int sig) { (void)pid; (void)sig; return -1; }
extern "C" int _getpid(void) { return 1; }

// ---------------------------------------------------------------------------
// 9. Main Entry Point
// ---------------------------------------------------------------------------
extern "C" int main(int argc, char **argv)
{
    (void)argc;
    (void)argv;

    uart_puts("\n======================================================\n");
    uart_puts("   SNOW BROS (NES MMC1) on NUCLEUSRV (Zybo Z7-10)     \n");
    uart_puts("   Core: RV32IM 5-Stage Pipelined RISC-V Softcore      \n");
    uart_puts("   Display: 320x200 HDMI Framebuffer @ 0x50000000      \n");
    uart_puts("   Palette: 64-Color NES Master Hardware Palette       \n");
    uart_puts("   Controls: BTN1=Jump, BTN2=Shoot | WASD, Space, J    \n");
    uart_puts("======================================================\n");

    // 1. Clear Framebuffer to Black (Palette Index 0x0F)
    for (int i = 0; i < 16000; ++i)
    {
        ((volatile uint32_t*)FB_MEM_BASE)[i] = 0x0F0F0F0F;
    }

    // 2. Load 64-color NES Master Palette into Hardware Palette RAM
    for (int i = 0; i < 64; ++i)
    {
        PALETTE_MEM_BASE[i] = s_nes_palette[i];
        NesPalette[i] = (WORD)i;
    }

    // 3. Configure Frame Skip
    // FrameSkip = 0: Full 60 FPS rendering
    // FrameSkip = 1: 30 FPS video with 60 FPS CPU logic (silky smooth on 25 MHz)
    FrameSkip = 1;

    // 4. Load ROM & Start Emulation
    uart_puts("[Main] Initializing InfoNES & mounting ROM...\n");
    if (InfoNES_Load("snow_bros.nes") != 0)
    {
        uart_puts("[Main] Failed to load ROM! Execution halted.\n");
        while (1);
    }

    uart_puts("[Main] ROM Loaded! Starting Snow Bros emulation loop...\n");
    InfoNES_Main();

    return 0;
}
