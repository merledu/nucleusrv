# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y18 [get_cells u_pll/clkfb_buf]
set_property LOC BUFGCTRL_X0Y17 [get_cells u_pll/clkout1_buf]
set_property LOC BUFGCTRL_X0Y16 [get_cells u_pll/clkout0_buf]

# Location of IO Primitives which is load of clock spine

# Location of clock ports
set_property LOC IOB_X0Y76 [get_ports clk]

# Clock net "u_pll/clk_tmds" driven by instance "u_pll/clkout1_buf" located at site "BUFGCTRL_X0Y17"
#startgroup
create_pblock {CLKAG_u_pll/clk_tmds}
add_cells_to_pblock [get_pblocks  {CLKAG_u_pll/clk_tmds}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="u_pll/clk_tmds"}]]]
resize_pblock [get_pblocks {CLKAG_u_pll/clk_tmds}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0}
#endgroup

# Clock net "u_pll/clk_pixel" driven by instance "u_pll/clkout0_buf" located at site "BUFGCTRL_X0Y16"
#startgroup
create_pblock {CLKAG_u_pll/clk_pixel}
add_cells_to_pblock [get_pblocks  {CLKAG_u_pll/clk_pixel}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="u_pll/clk_pixel"}]]]
resize_pblock [get_pblocks {CLKAG_u_pll/clk_pixel}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X1Y0:CLOCKREGION_X1Y0 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1}
#endgroup
